  const c = colores[color];

  return (
    <section>
      <h2 className={`text-lg font-semibold tracking-tight ${c.text} mb-3`}>
        {titulo} ({reservas.length})
      </h2>

      {/* Desktop: Tabla */}
      <div
        className={`${tema.tarjeta} rounded-xl border ${tema.borde} overflow-hidden shadow-sm hidden md:block`}
      >
        <table className="w-full">
          <thead className={tema.suave}>
            <tr>
              <th
                className={`px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider ${tema.texto2}`}
              >
                Fecha
              </th>
              <th
                className={`px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider ${tema.texto2}`}
              >
                Cliente
              </th>
              <th
                className={`px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider ${tema.texto2}`}
              >
