"use client";

import { useState, useEffect } from "react";
import { useRouter } from "next/navigation";
import AdminHeader from "@/components/admin/AdminHeader";
import ModalDetalles from "./ModalDetalles";
import { useTema, type Tema } from "@/lib/admin/tema";
import { useReservasSync } from "@/hooks/useReservasSync";
import SyncStatus from "@/components/admin/SyncStatus";
import { useColaMutaciones } from "@/hooks/useColaMutaciones";
import { useOnlineStatus } from "@/hooks/useOnlineStatus";
import ActivarNotificaciones from "@/components/admin/ActivarNotificaciones";

export type Reserva = {
  id: string;
  estudio_id: string;
  cliente_nombre: string;
  cliente_apellido: string;
  cliente_dni: string;
  cliente_telefono: string;
  estado: string;
  total: number;
  sena: number;
  mp_preference_id?: string;
  mp_payment_id?: string;
  servicio_ids?: string[];
  combo_ids?: string[];
  turno_ids?: string[];
  created_at: string;
  updated_at?: string;
};

export type Servicio = {
  id: string;
  nombre: string;
  precio: number;
  duracion_min: number;
  descripcion?: string;
};

export type Combo = {
  id: string;
  nombre: string;
  precio_oferta: number;
  descripcion?: string;
};

export type Turno = { id: string; inicio: string; fin: string; estado: string };
export type Estudio = { nombre: string; direccion: string; telefono: string };

export type ReservaDetalles = Reserva & {
  servicios: Servicio[];
  combos: Combo[];
  turnos: Turno[];
  estudio: Estudio | null;
};

type Estadisticas = {
  totalReservas: number;
  reservasHoy: number;
  confirmadasHoy: number;
  ingresosHoy: number;
  tasaConfirmacion: number;
  porDia: Record<string, number>;
  turnosHoy: Reserva[];
};

const formatearFecha = (iso: string) =>
  new Date(iso).toLocaleString("es-AR", {
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
    timeZone: "America/Argentina/Buenos_Aires",
  });

const formatearHora = (iso: string) => {
  const match = iso.match(/T(\d{2}):(\d{2})/);
  if (!match) return "Hora no disponible";
  const h = parseInt(match[1], 10);
  const m = match[2];
  const ampm = h >= 12 ? "p. m." : "a. m.";
  const h12 = h % 12 === 0 ? 12 : h % 12;
  return `${h12}:${m} ${ampm}`;
};

// --- COMPONENTE REUTILIZABLE (ahora usa el Tema real) ---
type SeccionReservasProps = {
  titulo: string;
  color: "amber" | "blue" | "green" | "red";
  reservas: Reserva[];
  tema: Tema;
  verDetalles: (id: string) => void;
  cambiarEstado: (id: string, estado: string) => void;
  mostrarConfirmar: boolean;
  mostrarCancelar: boolean;
  pendientes: Set<string>;
};

