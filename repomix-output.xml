// --- COMPONENTE PRINCIPAL ---
export default function ReservasClient({
  reservas,
  estudioId,
}: {
  reservas: Reserva[];
  estudioId: string;
}) {
  const router = useRouter();
  const tema = useTema(); // ✅ UNA sola fuente de verdad
  const { ultimoSync } = useReservasSync(reservas);

  const { isOnline } = useOnlineStatus();
  const { pendientes, encolar } = useColaMutaciones();

  // ✅ Overrides locales: cambios offline que se ven al instante (sin setState en effect)
  const [overrides, setOverrides] = useState<Record<string, string>>({});
  const reservasMostrar = reservas.map((r) =>
    overrides[r.id] ? { ...r, estado: overrides[r.id] } : r,
  );

  const [detalles, setDetalles] = useState<ReservaDetalles | null>(null);
  const [estadisticas, setEstadisticas] = useState<Estadisticas | null>(null);

  const bloqueadas = reservasMostrar.filter((r) => r.estado === "bloqueada");
  const pagadas = reservasMostrar.filter((r) => r.estado === "pagada");
  const confirmadas = reservasMostrar.filter((r) => r.estado === "confirmada");
  const canceladas = reservasMostrar.filter((r) => r.estado === "cancelada");

  useEffect(() => {
    const cargarDatos = async () => {
      try {
        const resEst = await fetch(
          `/api/admin/estadisticas?estudioId=${estudioId}`,
        );
        const dataEst = await resEst.json();
        if (dataEst.ok) setEstadisticas(dataEst.data);
      } catch (error) {
        console.error("Error cargando datos:", error);
      }
    };
    cargarDatos();
  }, [estudioId]);

  const cambiarEstado = async (id: string, estado: string) => {
    const tipo = estado === "confirmada" ? "confirmar" : "cancelar";

    // 🟡 OFFLINE → encolar + optimismo local
    if (!isOnline) {
      await encolar(tipo, id);
      setOverrides((prev) => ({ ...prev, [id]: estado }));
      return;
    }

    // 🟢 ONLINE → PATCH normal
    try {
      const res = await fetch(`/api/admin/reservas/${id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ estado }),
      });
      const data = await res.json();
      if (data.ok) window.location.reload();
      else alert(data.mensaje || "Error");
    } catch {
      // Se cayó la conexión justo ahora → encolar igual
      await encolar(tipo, id);
      setOverrides((prev) => ({ ...prev, [id]: estado }));
    }
  };

  const verDetalles = async (id: string) => {
    try {
      const res = await fetch(`/api/admin/reservas/${id}`);
      const data = await res.json();
      if (data.ok) setDetalles(data.reserva);
      else alert(data.mensaje || "Error");
    } catch {
      alert("Error de conexión");
    }
  };

  const maxReservasDia = estadisticas
    ? Math.max(...Object.values(estadisticas.porDia), 1)
    : 1;

  return (
    <div
      className={`min-h-screen ${tema.bg} ${tema.texto} transition-colors duration-300`}
    >
      <div className="mx-auto max-w-7xl px-3 pb-28 pt-4 sm:px-6 sm:pb-10 sm:pt-8">
        {/* ✅ Header unificado con las demás páginas */}
        <AdminHeader
          tema={tema}
          icono="📋"
          titulo="Panel de Administración"
          subtitulo="Gestión de reservas y turnos"
          links={[
            {
              href: "/admin/horarios",
              label: "Horarios",
              icono: "🕒",
              color: "blue",
            },
            {
              href: "/admin/servicios",
              label: "Servicios",
              icono: "💅",
              color: "pink",
            },
            {
              href: "/admin/combos",
              label: "Combos",
              icono: "🎁",
              color: "purple",
            },
            {
              href: "/admin/configuracion",
              label: "Personalización",
              icono: "🎨",
              color: "fuchsia",
            },
            {
              href: "/admin/campanas",
              label: "Campañas",
              icono: "📣",
              color: "fuchsia",
            },
            {
              href: "/admin/compartir",
              label: "Compartir",
              icono: "📢",
              color: "emerald",
            },
          ]}
        />

        {/* Botón de cerrar sesión discreto */}
        <div className="flex justify-between items-center mb-6">
          <SyncStatus ultimoSync={ultimoSync} />
          <button
            onClick={async () => {
              await fetch("/api/admin/logout", { method: "POST" });
              router.push("/admin/login");
            }}
            className={`h-9 px-4 text-xs font-medium ${tema.btnNeutro}`}
          >
            🚪 Cerrar sesión
          </button>
        </div>

        <div className="mb-6">
          <ActivarNotificaciones estudioId={estudioId} />
        </div>

        {/* ESTADÍSTICAS */}
        {estadisticas && (
          <div className="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-2xl shadow-sm p-5 sm:p-6 mb-6 text-white">
            <h2 className="text-lg font-semibold tracking-tight mb-4 flex items-center gap-2">
              📊 Resumen de hoy
            </h2>
            <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
              <div className="bg-white/15 backdrop-blur rounded-xl p-4">
                <p className="text-xs opacity-80">Reservas hoy</p>
                <p className="text-2xl md:text-3xl font-bold">
                  {estadisticas.reservasHoy}
                </p>
              </div>
              <div className="bg-white/15 backdrop-blur rounded-xl p-4">
                <p className="text-xs opacity-80">Ingresos</p>
                <p className="text-2xl md:text-3xl font-bold">
                  ${estadisticas.ingresosHoy.toLocaleString("es-AR")}
                </p>
              </div>
              <div className="bg-white/15 backdrop-blur rounded-xl p-4">
                <p className="text-xs opacity-80">Confirmadas</p>
                <p className="text-2xl md:text-3xl font-bold">
                  {estadisticas.confirmadasHoy}
                </p>
              </div>
              <div className="bg-white/15 backdrop-blur rounded-xl p-4">
                <p className="text-xs opacity-80">Tasa</p>
                <p className="text-2xl md:text-3xl font-bold">
                  {estadisticas.tasaConfirmacion}%
                </p>
              </div>
            </div>
          </div>
        )}

        {/* PRÓXIMOS TURNOS */}
        {estadisticas &&
          estadisticas.turnosHoy &&
          estadisticas.turnosHoy.length > 0 && (
            <div
              className={`${tema.tarjeta} rounded-2xl border ${tema.borde} shadow-sm p-5 sm:p-6 mb-6`}
            >
              <h2
                className={`text-lg font-semibold tracking-tight ${tema.texto} mb-4`}
              >
                ⏰ Próximos turnos de hoy
              </h2>
              <div className="space-y-2">
                {estadisticas.turnosHoy.map((turno) => (
                  <div
                    key={turno.id}
                    className={`flex items-center justify-between p-3 ${tema.suave} rounded-xl ${tema.filaHover} transition-colors`}
                  >
                    <div className="flex items-center gap-3">
                      <div className="bg-indigo-500/15 text-indigo-500 px-3 py-1 rounded-full text-sm font-semibold">
                        {formatearHora(turno.created_at)}
                      </div>
                      <div>
                        <p className={`font-medium ${tema.texto}`}>
                          {turno.cliente_nombre} {turno.cliente_apellido}
                        </p>
                        <p className={`text-xs ${tema.texto2}`}>
                          Tel: {turno.cliente_telefono}
                        </p>
                      </div>
                    </div>
                    <div className="flex items-center gap-2">
                      <span
                        className={`px-2.5 py-0.5 rounded-full text-xs font-medium ${tema.badge(true)}`}
                      >
                        {turno.estado}
                      </span>
                      <button
                        onClick={() => verDetalles(turno.id)}
                        className="bg-blue-500/15 text-blue-600 px-3 py-1.5 rounded-lg text-xs font-medium hover:bg-blue-500/25 transition-colors"
                      >
                        Ver
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

        {/* GRÁFICO SEMANAL */}
        {estadisticas && Object.keys(estadisticas.porDia).length > 0 && (
          <div
            className={`${tema.tarjeta} rounded-2xl border ${tema.borde} shadow-sm p-5 sm:p-6 mb-6`}
          >
            <h2
              className={`text-lg font-semibold tracking-tight ${tema.texto} mb-4`}
            >
              📈 Actividad últimos 7 días
            </h2>
            <div className="flex items-end gap-2 h-40">
              {Object.entries(estadisticas.porDia).map(([dia, cantidad]) => (
                <div
                  key={dia}
                  className="flex-1 flex flex-col items-center gap-1"
                >
                  <span className={`text-xs font-semibold ${tema.texto2}`}>
                    {cantidad}
                  </span>
                  <div
                    className="w-full bg-gradient-to-t from-indigo-500 to-purple-500 rounded-t-lg transition-all"
                    style={{ height: `${(cantidad / maxReservasDia) * 100}%` }}
                  ></div>
                  <span className={`text-xs ${tema.texto2} capitalize`}>
                    {dia}
                  </span>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* SECCIONES DE RESERVAS */}
        <div className="space-y-6">
          <SeccionReservas
            titulo="⏳ Pendientes de pago"
            color="amber"
            reservas={bloqueadas}
            tema={tema}
            verDetalles={verDetalles}
            cambiarEstado={cambiarEstado}
            pendientes={pendientes}
            mostrarConfirmar
            mostrarCancelar
          />
          <SeccionReservas
            titulo="💳 Pagadas"
            color="blue"
            reservas={pagadas}
            tema={tema}
            verDetalles={verDetalles}
            cambiarEstado={cambiarEstado}
            pendientes={pendientes}
            mostrarConfirmar
            mostrarCancelar={false}
          />
          <SeccionReservas
            titulo="✅ Confirmadas"
            color="green"
            reservas={confirmadas}
            tema={tema}
            verDetalles={verDetalles}
            cambiarEstado={cambiarEstado}
            pendientes={pendientes}
            mostrarConfirmar={false}
            mostrarCancelar={false}
          />
          <SeccionReservas
            titulo="❌ Canceladas"
            color="red"
            reservas={canceladas}
            tema={tema}
            verDetalles={verDetalles}
            cambiarEstado={cambiarEstado}
            pendientes={pendientes}
            mostrarConfirmar={false}
            mostrarCancelar={false}
          />

          {reservas.length === 0 && (
            <div
              className={`${tema.tarjeta} rounded-2xl p-8 text-center border ${tema.borde} shadow-sm`}
            >
              <p className={`${tema.texto2} text-lg`}>
                No hay reservas todavía
              </p>
            </div>
          )}
        </div>
      </div>

      {detalles && (
        <ModalDetalles
          detalles={detalles}
          onClose={() => setDetalles(null)}
          onCambiarEstado={cambiarEstado}
        />
      )}
    </div>
  );
}
</file>

</files>
