      text: "text-blue-600",
      textDark: "text-blue-700",
      badge: "bg-blue-500/15 text-blue-600",
    },
    green: {
      text: "text-emerald-600",
      textDark: "text-emerald-700",
      badge: "bg-emerald-500/15 text-emerald-600",
    },
    red: {
      text: "text-red-600",
      textDark: "text-red-700",
      badge: "bg-red-500/15 text-red-600",
