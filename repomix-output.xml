<file path="hooks/useColaMutaciones.ts">
"use client";

import { useState, useEffect, useCallback } from "react";
import {
  agregarMutacion,
  obtenerMutacionesPendientes,
  eliminarMutacion,
  dbPut,
  STORES,
} from "@/lib/db";
import { useOnlineStatus } from "./useOnlineStatus";

const MAX_INTENTOS = 3;

export function useColaMutaciones() {
  const { isOnline } = useOnlineStatus();
  const [pendientes, setPendientes] = useState<Set<string>>(new Set());

  // Cargar la cola pendiente al montar
  useEffect(() => {
    let cancelado = false;
    const cargar = async () => {
      try {
        const muts = await obtenerMutacionesPendientes();
        if (!cancelado && muts.length) {
          setPendientes(new Set(muts.map((m) => m.reservaId)));
        }
      } catch (e) {
        console.error("[cola] error cargando:", e);
      }
    };
    cargar();
    return () => {
      cancelado = true;
    };
  }, []);

  // Procesa la cola y devuelve CUÁNTAS se aplicaron con éxito
  const procesarCola = useCallback(async (): Promise<number> => {
    const muts = await obtenerMutacionesPendientes();
    if (muts.length === 0) return 0;

    let procesadas = 0;

    for (const m of muts) {
      const intentos = m.intentos || 0;

      // 🛡️ Mutación zombi: tras 3 intentos fallidos se descarta y no bloquea más
      if (intentos >= MAX_INTENTOS) {
        console.warn(
          "[cola] mutación descartada tras",
          intentos,
          "intentos:",
          m,
        );
        if (m.id != null) await eliminarMutacion(m.id);
        continue;
      }

      try {
        const res = await fetch(`/api/admin/reservas/${m.reservaId}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            estado: m.tipo === "confirmar" ? "confirmada" : "cancelada",
          }),
        });

        if (res.ok) {
          const data = await res.json();
          if (data.ok && m.id != null) {
            await eliminarMutacion(m.id);
            procesadas++;
            continue;
          }
        }

        // Fallo de servidor (401/404/500): sumamos un intento
        await dbPut(STORES.COLA_MUTACIONES, { ...m, intentos: intentos + 1 });
        if (res.status === 401) break; // sesión caída: reintentar no sirve
      } catch {
        break; // se cortó la red de nuevo: la mutación queda para después
      }
    }

    return procesadas;
  }, []);

  // Al volver la conexión → procesar. SOLO recargar si se aplicó algo.
  useEffect(() => {
    if (!isOnline) return;
    let cancelado = false;
    const run = async () => {
      try {
        const procesadas = await procesarCola();
        // ✅ FIX DEL BUCLE: recargamos SOLO si hubo éxito real
        if (procesadas > 0 && !cancelado) window.location.reload();
      } catch (e) {
        console.error("[cola] error procesando:", e);
      }
    };
    run();
    return () => {
      cancelado = true;
    };
  }, [isOnline, procesarCola]);

  const encolar = useCallback(
    async (tipo: "confirmar" | "cancelar", reservaId: string) => {
      await agregarMutacion({ tipo, reservaId });
      setPendientes((prev) => new Set(prev).add(reservaId));
    },
    [],
  );

  return { pendientes, encolar };
}
</file>

<file path="hooks/usePushNotifications.ts">
"use client";

import { useState, useEffect } from "react";

type EstadoPush =
  | "inicializando"
  | "no-soportado"
  | "sin-permiso"
  | "solicitando"
  | "suscrito"
  | "error";

export function usePushNotifications(estudioId: string) {
  const [estado, setEstado] = useState<EstadoPush>("inicializando");
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    let cancelado = false;

    const verificar = async () => {
      console.log("[push] serviceWorker:", "serviceWorker" in navigator);
      console.log("[push] PushManager:", "PushManager" in window);
      console.log("[push] permission:", Notification.permission);

      if (!("serviceWorker" in navigator) || !("PushManager" in window)) {
        if (!cancelado) setEstado("no-soportado");
        return;
      }

      try {
        const registration = await navigator.serviceWorker.getRegistration();
        if (!registration) {
          // Sin Service Worker (desarrollo) no hay push: no nos quedamos colgados
          if (!cancelado) setEstado("no-soportado");
          return;
        }
        const suscripcion = await registration.pushManager.getSubscription();
        console.log(
          "[push] suscripcion navegador:",
          suscripcion ? suscripcion.endpoint : "NINGUNA",
        );

        if (suscripcion) {
          const ok = await guardarSuscripcion(suscripcion, estudioId);
          if (!cancelado) setEstado(ok ? "suscrito" : "error");
        } else {
          if (!cancelado) setEstado("sin-permiso");
        }
      } catch (e) {
        console.error("[push] error:", e);
        if (!cancelado) setEstado("sin-permiso");
      }
    };

    verificar();
    return () => {
      cancelado = true;
    };
  }, [estudioId]);

  const solicitarPermiso = async () => {
    setEstado("solicitando");
    setError(null);

    try {
      const permiso = await Notification.requestPermission();
      console.log("[push] requestPermission:", permiso);
      if (permiso !== "granted") {
        setEstado("sin-permiso");
        setError("Permiso denegado.");
        return;
      }

      const registration = await navigator.serviceWorker.getRegistration();
      if (!registration) {
        setEstado("sin-permiso");
        setError(
          "Las notificaciones requieren el Service Worker: probalas en producción (Vercel).",
        );
        return;
      }
      const suscripcion = await registration.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: urlBase64ToUint8Array(
          process.env.NEXT_PUBLIC_VAPID_PUBLIC_KEY || "",
        ),
      });
      console.log("[push] nueva suscripcion:", suscripcion.endpoint);

      const ok = await guardarSuscripcion(suscripcion, estudioId);
      if (ok) {
        setEstado("suscrito");
      } else {
        setEstado("error");
        setError("Falló guardar en el servidor. Mirá el log POST suscribir.");
      }
    } catch (e: unknown) {
      setEstado("error");
      setError(e instanceof Error ? e.message : "Error desconocido");
    }
  };

  return { estado, error, solicitarPermiso };
}

async function guardarSuscripcion(
  suscripcion: PushSubscription,
  estudioId: string,
): Promise<boolean> {
  try {
    const res = await fetch("/api/admin/push/suscribir", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        estudioId,
        suscripcion: {
          endpoint: suscripcion.endpoint,
          keys: {
            p256dh: arrayBufferToBase64(suscripcion.getKey("p256dh")!),
            auth: arrayBufferToBase64(suscripcion.getKey("auth")!),
          },
        },
      }),
    });
    const data = await res.json();
    console.log("[push] POST suscribir →", res.status, data);
    return data.ok === true;
  } catch (e) {
    console.error("[push] POST ERROR:", e);
    return false;
  }
}

function urlBase64ToUint8Array(base64String: string): Uint8Array<ArrayBuffer> {
  const padding = "=".repeat((4 - (base64String.length % 4)) % 4);
  const base64 = (base64String + padding).replace(/-/g, "+").replace(/_/g, "/");
  const rawData = window.atob(base64);
  const outputArray = new Uint8Array(rawData.length);
  for (let i = 0; i < rawData.length; ++i) {
    outputArray[i] = rawData.charCodeAt(i);
  }
  return outputArray;
}

function arrayBufferToBase64(buffer: ArrayBuffer): string {
  const bytes = new Uint8Array(buffer);
  let binary = "";
  for (let i = 0; i < bytes.byteLength; i++) {
    binary += String.fromCharCode(bytes[i]);
  }
  return window.btoa(binary);
}
