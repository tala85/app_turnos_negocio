              maxLength={140}
              className={campo}
            />
          </div>

          <div>
            <label htmlFor="svc-precio" className={label}>Precio</label>
            <div className="relative">
              <span className={`pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm font-semibold ${tema.texto2}`}>$</span>
              <input
                id="svc-precio"
                type="number"
                inputMode="numeric"
                min={0}
                step={1}
                value={datos.precio}
                onChange={(e) => setDatos({ ...datos, precio: e.target.value })}
                placeholder="0"
                className={`${campo} pl-8`}
              />
            </div>
          </div>

          <div>
            <label htmlFor="svc-duracion" className={label}>Duración (minutos)</label>
            <input
              id="svc-duracion"
              type="number"
              inputMode="numeric"
              min={5}
              step={5}
              value={datos.duracion_min}
              onChange={(e) => setDatos({ ...datos, duracion_min: e.target.value })}
              className={campo}
            />
          </div>

          <div className="adm-scroll -mx-1 flex gap-2 overflow-x-auto px-1 pb-1 sm:col-span-2">
            {DURACIONES.map((d) => {
              const sel = Number(datos.duracion_min) === d;
              return (
                <button
                  key={d}
                  type="button"
                  onClick={() => setDatos({ ...datos, duracion_min: String(d) })}
                  className={`shrink-0 rounded-full border px-3.5 py-2 text-xs font-semibold transition-all ${
                    sel
                      ? "border-pink-500 bg-pink-500 text-white shadow-md shadow-pink-500/25"
                      : `${tema.borde} ${tema.suave} ${tema.texto2}`
                  }`}
                >
                  {duracionTexto(d)}
                </button>
              );
            })}
          </div>

          <div className="flex flex-col gap-2 sm:col-span-2 sm:flex-row">
            <button
              type="submit"
              disabled={!valido || guardando}
              className={`h-12 flex-1 rounded-xl text-sm font-bold transition-all disabled:cursor-not-allowed disabled:opacity-45 disabled:shadow-none ${tema.btnPrimario}`}
            >
              {guardando ? "Guardando..." : editando ? "💾 Actualizar servicio" : "💾 Guardar servicio"}
            </button>
            {editando && (
              <button
                type="button"
                onClick={onCancelar}
                className={`h-12 rounded-xl px-6 text-sm font-bold transition-colors ${tema.btnNeutro}`}
              >
                Cancelar
              </button>
            )}
          </div>

          {!valido && datos.nombre.length > 0 && (
            <p className="text-xs font-medium text-amber-500 sm:col-span-2">
              Completá un nombre de al menos 2 caracteres, un precio válido y una duración de 5 minutos o más.
            </p>
          )}
        </form>
      )}
    </section>
  );
}
</file>

<file path="components/servicios/ServiciosFiltros.tsx">
"use client";

import type { Tema } from "@/lib/admin/tema";
import type { Filtro, Orden } from "@/features/servicios/types";

type Props = {
  tema: Tema;
  total: number;
  activos: number;
  inactivos: number;
  visibles: number;
  busqueda: string;
  setBusqueda: (v: string) => void;
  filtro: Filtro;
  setFiltro: (v: Filtro) => void;
  orden: Orden;
  setOrden: (v: Orden) => void;
  onLimpiar: () => void;
};

export default function ServiciosFiltros({
  tema, total, activos, inactivos, visibles,
  busqueda, setBusqueda, filtro, setFiltro, orden, setOrden, onLimpiar,
}: Props) {
  const tarjetas = [
    { key: "todos" as const, label: "Total", valor: total, acento: "from-pink-500 to-fuchsia-600" },
    { key: "activos" as const, label: "Activos", valor: activos, acento: "from-emerald-500 to-teal-600" },
    { key: "inactivos" as const, label: "Inactivos", valor: inactivos, acento: "from-amber-500 to-orange-600" },
  ];

  const campo = `h-11 rounded-xl border text-sm outline-none transition focus:border-pink-500 focus:ring-2 focus:ring-pink-500/25 ${tema.input}`;

  return (
    <>
      <div className="mb-4 grid grid-cols-3 gap-2 sm:gap-3">
        {tarjetas.map((c) => {
          const sel = filtro === c.key;
          return (
            <button
              key={c.key}
              type="button"
              onClick={() => setFiltro(c.key)}
              aria-pressed={sel}
              className={`relative overflow-hidden rounded-xl border p-3 text-left transition-all hover:-translate-y-0.5 ${tema.tarjeta} ${
                sel ? "border-pink-500 ring-2 ring-pink-500/30" : tema.borde
              }`}
            >
              <span className={`absolute inset-x-0 top-0 h-1 bg-gradient-to-r ${c.acento}`} />
              <p className={`text-[11px] uppercase tracking-wide ${tema.texto2}`}>{c.label}</p>
              <p className="mt-1 text-2xl font-bold tabular-nums">{c.valor}</p>
            </button>
          );
        })}
      </div>

      <div className={`${tema.tarjeta} mb-3 rounded-2xl border ${tema.borde} p-3 shadow-sm sm:mb-4 sm:p-4`}>
        <div className="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
          <div className="relative flex-1">
            <span className="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm">🔍</span>
            <input
              type="search"
              value={busqueda}
              onChange={(e) => setBusqueda(e.target.value)}
              placeholder="Buscar por nombre o descripción..."
              aria-label="Buscar servicios"
              className={`${campo} w-full pl-9 pr-9`}
            />
            {busqueda && (
              <button
                type="button"
                onClick={() => setBusqueda("")}
                aria-label="Limpiar búsqueda"
                className={`absolute right-2 top-1/2 grid h-7 w-7 -translate-y-1/2 place-items-center rounded-full text-xs ${tema.suave} ${tema.texto2}`}
              >
                ✕
              </button>
            )}
          </div>

          <select
            value={orden}
            onChange={(e) => setOrden(e.target.value as Orden)}
            aria-label="Ordenar servicios"
            className={`${campo} px-3`}
          >
            <option value="nombre">Nombre (A–Z)</option>
            <option value="precio-asc">Precio: menor a mayor</option>
            <option value="precio-desc">Precio: mayor a menor</option>
            <option value="duracion">Duración: menor a mayor</option>
          </select>
        </div>

        {(busqueda !== "" || filtro !== "todos") && (
          <p className={`mt-2 text-xs ${tema.texto2}`}>
            Mostrando <strong className={tema.texto}>{visibles}</strong> de {total} servicios ·{" "}
            <button type="button" onClick={onLimpiar} className="font-semibold text-pink-500 underline underline-offset-2">
              Limpiar filtros
            </button>
          </p>
        )}
      </div>
    </>
  );
}
</file>

<file path="components/servicios/ServiciosLista.tsx">
"use client";

import type { Tema } from "@/lib/admin/tema";
import type { Servicio } from "@/features/servicios/types";
import { duracionTexto, money } from "@/features/servicios/utils";
import ServicioCard from "./ServicioCard";

type Props = {
  tema: Tema;
  cargando: boolean;
  error: string | null;
  total: number;
  visibles: Servicio[];
  busyId: string | null;
  onReintentar: () => void;
  onNuevo: () => void;
  onLimpiarFiltros: () => void;
  onEditar: (s: Servicio) => void;
  onToggle: (s: Servicio) => void;
  onEliminar: (s: Servicio) => void;
};

export default function ServiciosLista({
  tema, cargando, error, total, visibles, busyId,
  onReintentar, onNuevo, onLimpiarFiltros, onEditar, onToggle, onEliminar,
}: Props) {
  const caja = `${tema.tarjeta} rounded-2xl border ${tema.borde} shadow-sm`;
  const th = `px-4 py-3 text-left text-xs font-bold uppercase tracking-wide ${tema.texto2}`;

  if (cargando) {
    return (
      <div className="space-y-3">
        {[0, 1, 2].map((i) => (
          <div key={i} className={`${tema.tarjeta} h-32 animate-pulse rounded-2xl border ${tema.borde}`} />
        ))}
      </div>
    );
  }

  if (error) {
    return (
      <div className={`${caja} p-8 text-center`}>
        <p className="text-3xl">⚠️</p>
        <p className="mt-2 font-semibold">{error}</p>
        <button type="button" onClick={onReintentar} className={`mt-4 h-11 rounded-xl px-6 text-sm font-bold ${tema.btnPrimario}`}>
          Reintentar
        </button>
      </div>
    );
  }

  if (total === 0) {
    return (
      <div className={`${caja} p-10 text-center`}>
        <div className="mx-auto grid h-16 w-16 place-items-center rounded-2xl bg-gradient-to-br from-pink-500/15 to-fuchsia-600/15 text-3xl">💅</div>
        <p className="mt-4 text-lg font-bold">Todavía no cargaste servicios</p>
        <p className={`mt-1 text-sm ${tema.texto2}`}>Creá el primero y va a aparecer en la página de reservas.</p>
        <button type="button" onClick={onNuevo} className={`mt-5 h-12 rounded-xl px-6 text-sm font-bold ${tema.btnPrimario}`}>
          ➕ Crear mi primer servicio
        </button>
      </div>
    );
  }

  if (visibles.length === 0) {
    return (
      <div className={`${caja} p-10 text-center`}>
        <p className="text-3xl">🔍</p>
        <p className="mt-3 font-bold">Sin resultados</p>
        <p className={`mt-1 text-sm ${tema.texto2}`}>Ningún servicio coincide con la búsqueda o el filtro elegido.</p>
        <button type="button" onClick={onLimpiarFiltros} className={`mt-5 h-11 rounded-xl px-6 text-sm font-bold ${tema.btnPrimario}`}>
          Limpiar filtros
        </button>
      </div>
    );
  }

  return (
    <>
      <div className={`${caja} adm-scroll hidden overflow-x-auto md:block`}>
        <table className="w-full">
          <thead className={tema.suave}>
            <tr>
              <th className={th}>Servicio</th>
              <th className={th}>Duración</th>
              <th className={th}>Precio</th>
              <th className={th}>Estado</th>
              <th className={th}>Acciones</th>
            </tr>
          </thead>
          <tbody className={`divide-y ${tema.divisor}`}>
            {visibles.map((s) => (
              <tr key={s.id} className={`transition-colors ${tema.filaHover} ${busyId === s.id ? "opacity-60" : ""}`}>
                <td className="px-4 py-3">
                  <div className="font-semibold">{s.nombre}</div>
                  {s.descripcion && <div className={`mt-0.5 text-xs ${tema.texto2}`}>{s.descripcion}</div>}
                </td>
                <td className={`px-4 py-3 text-sm ${tema.texto2}`}>{duracionTexto(s.duracion_min)}</td>
                <td className="px-4 py-3 text-sm font-bold tabular-nums">{money(s.precio)}</td>
                <td className="px-4 py-3">
                  <span className={`rounded-full px-2.5 py-1 text-xs font-semibold ${tema.badge(s.activo)}`}>
                    {s.activo ? "Activo" : "Inactivo"}
                  </span>
                </td>
                <td className="px-4 py-3">
                  <div className="flex flex-wrap gap-2">
                    <button type="button" onClick={() => onEditar(s)} className="rounded-lg bg-blue-500/15 px-3 py-1.5 text-xs font-semibold text-blue-500 transition-colors hover:bg-blue-500/25">
                      ✏️ Editar
                    </button>
                    <button
                      type="button"
                      disabled={busyId === s.id}
                      onClick={() => onToggle(s)}
                      className={`rounded-lg px-3 py-1.5 text-xs font-semibold transition-colors disabled:opacity-50 ${
                        s.activo
                          ? "bg-amber-500/15 text-amber-600 hover:bg-amber-500/25"
                          : "bg-emerald-500/15 text-emerald-600 hover:bg-emerald-500/25"
                      }`}
                    >
                      {s.activo ? "Desactivar" : "Activar"}
                    </button>
                    <button type="button" onClick={() => onEliminar(s)} className="rounded-lg bg-red-500/15 px-3 py-1.5 text-xs font-semibold text-red-500 transition-colors hover:bg-red-500/25">
                      🗑️ Eliminar
                    </button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div className="space-y-3 md:hidden">
        {visibles.map((s) => (
          <ServicioCard
            key={s.id}
            tema={tema}
            servicio={s}
            ocupado={busyId === s.id}
            onEditar={() => onEditar(s)}
            onToggle={() => onToggle(s)}
            onEliminar={() => onEliminar(s)}
          />
        ))}
      </div>
    </>
  );
}
</file>

