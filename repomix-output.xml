<file path="components/resumen/ResumenReserva.tsx">
"use client";

import { useState } from "react";
import type { ItemReserva, ClienteInput } from "@/lib/types";

type HorarioDisponible = {
  inicio: string;
  fin: string;
  slots_necesarios: number;
};

type Props = {
  items: ItemReserva[];
  total: number;
  sena: number;
  minutos: number;
  requiereSena: boolean;
  fecha: string;
  horario: HorarioDisponible | null;
  cliente: ClienteInput;
  onConfirmar: () => void;
  cargando: boolean;
  error: string | null;
  colores: { primario: string; secundario: string; fondo: string };
};

const formatearHora = (iso: string) => {
  const match = iso.match(/T(\d{2}):(\d{2})/);
  if (!match) return "";
  const h = parseInt(match[1], 10);
  const m = match[2];
  const ampm = h >= 12 ? "p. m." : "a. m.";
  const h12 = h % 12 === 0 ? 12 : h % 12;
  return `${h12}:${m} ${ampm}`;
};

export default function ResumenReserva({
  items,
  total,
  sena,
  minutos,
  requiereSena,
  fecha,
  horario,
  cliente,
  onConfirmar,
  cargando,
  error,
  colores,
}: Props) {
  const [abierto, setAbierto] = useState(false);
  const puedeConfirmar =
    items.length > 0 &&
    fecha &&
    horario &&
    cliente.nombre &&
    cliente.apellido &&
    cliente.telefono;

  // Versión mobile: drawer
  if (typeof window !== "undefined" && window.innerWidth < 768) {
    return (
      <>
        {/* Botón flotante para abrir */}
        <button
          type="button"
          onClick={() => setAbierto(true)}
          disabled={!puedeConfirmar || cargando}
          className="fixed bottom-4 left-4 right-4 z-40 h-14 rounded-2xl text-white font-bold text-lg shadow-2xl transition-all disabled:opacity-50 disabled:cursor-not-allowed md:hidden"
          style={{
            backgroundColor: puedeConfirmar ? colores.primario : "#9ca3af",
          }}
        >
          {cargando
            ? "Procesando..."
            : requiereSena
              ? `Pagar seña $${sena.toLocaleString("es-AR")}`
              : "Confirmar Reserva"}
        </button>

        {/* Drawer */}
        {abierto && (
          <div className="fixed inset-0 z-50 md:hidden">
            <div
              className="absolute inset-0 bg-black/60 backdrop-blur-sm"
              onClick={() => setAbierto(false)}
            />

