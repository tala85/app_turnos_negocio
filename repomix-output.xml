<file path="components/turnos/Calendario.tsx">
"use client";

import { useMemo, useState } from "react";

type Props = {
  fechaSeleccionada: string;
  onChange: (fecha: string) => void;
  minFecha?: string;
  maxFecha?: string;
  label?: string;
  horariosDisponibles?: {
    dia_semana: number;
    hora_inicio: string;
    hora_fin: string;
  }[];
  excepciones?: {
    fecha: string;
    hora_inicio: string;
    hora_fin: string;
  }[];
};

export default function Calendario({
  fechaSeleccionada,
  onChange,
  minFecha,
  maxFecha,
  label = "Seleccioná una fecha",
  horariosDisponibles = [],
  excepciones = [],
}: Props) {
  const hoy = useMemo(() => {
    const h = new Date();
    h.setHours(0, 0, 0, 0);
    return h;
  }, []);

  const [mesVista, setMesVista] = useState(() => {
    const fecha = fechaSeleccionada ? new Date(fechaSeleccionada) : hoy;
    return { año: fecha.getFullYear(), mes: fecha.getMonth() };
  });

  const min = useMemo(() => {
    return minFecha ? new Date(minFecha) : hoy;
  }, [minFecha, hoy]);

  const max = useMemo(() => {
    const maxDefault = new Date(hoy);
    maxDefault.setDate(maxDefault.getDate() + 90);
    return maxFecha ? new Date(maxFecha) : maxDefault;
  }, [maxFecha, hoy]);

  // ✅ Verificar si un día tiene horarios disponibles
  const diaTieneHorario = (fecha: Date): boolean => {
    const fechaStr = fecha.toISOString().split("T")[0];

    // Primero verificar si hay una excepción para esta fecha
    const tieneExcepcion = excepciones.some((e) => e.fecha === fechaStr);
    if (tieneExcepcion) return true;

    // Si no hay excepción, verificar si el día de la semana tiene horario
    const diaSemana = fecha.getDay();
    return horariosDisponibles.some((h) => h.dia_semana === diaSemana);
  };

  const diasDelMes = useMemo(() => {
    const primerDia = new Date(mesVista.año, mesVista.mes, 1);
    const ultimoDia = new Date(mesVista.año, mesVista.mes + 1, 0);
    const diasEnMes = ultimoDia.getDate();
    const diaInicio = primerDia.getDay();

    const dias: (number | null)[] = [];
    for (let i = 0; i < diaInicio; i++) dias.push(null);
    for (let d = 1; d <= diasEnMes; d++) dias.push(d);

    return dias;
  }, [mesVista]);

  const mesAnterior = () => {
    setMesVista((prev) => {
      if (prev.mes === 0) return { año: prev.año - 1, mes: 11 };
      return { ...prev, mes: prev.mes - 1 };
    });
  };

  const mesSiguiente = () => {
    setMesVista((prev) => {
      if (prev.mes === 11) return { año: prev.año + 1, mes: 0 };
      return { ...prev, mes: prev.mes + 1 };
    });
  };

  const seleccionarFecha = (dia: number) => {
    const mesStr = String(mesVista.mes + 1).padStart(2, "0");
    const diaStr = String(dia).padStart(2, "0");
    const fechaStr = `${mesVista.año}-${mesStr}-${diaStr}`;
    onChange(fechaStr);
  };

  const esFechaValida = (dia: number) => {
    const fecha = new Date(mesVista.año, mesVista.mes, dia);
    // ✅ Eliminada la variable fechaStr que no se usaba
    return fecha >= min && fecha <= max && diaTieneHorario(fecha);
  };

  const meses = [
    "Enero",
    "Febrero",
    "Marzo",
    "Abril",
    "Mayo",
    "Junio",
    "Julio",
    "Agosto",
    "Septiembre",
    "Octubre",
    "Noviembre",
    "Diciembre",
  ];

  const diasSemana = ["Do", "Lu", "Ma", "Mi", "Ju", "Vi", "Sá"];

  return (
    <div className="w-full">
      <label className="block text-sm font-semibold text-gray-700 mb-2">
        {label}
      </label>

      <div className="flex items-center justify-between mb-4">
        <button
          type="button"
          onClick={mesAnterior}
          className="p-2 rounded-xl hover:bg-gray-100 text-gray-600 transition-colors"
          aria-label="Mes anterior"
        >
          ←
        </button>

        <h3 className="font-bold text-gray-800 capitalize">
          {meses[mesVista.mes]} {mesVista.año}
        </h3>

        <button
          type="button"
          onClick={mesSiguiente}
          className="p-2 rounded-xl hover:bg-gray-100 text-gray-600 transition-colors"
          aria-label="Mes siguiente"
        >
          →
        </button>
      </div>

      <div className="grid grid-cols-7 gap-1 mb-2">
        {diasSemana.map((d) => (
          <div
            key={d}
            className="text-center text-xs font-medium text-gray-500 py-2"
          >
            {d}
          </div>
        ))}
      </div>

      <div className="grid grid-cols-7 gap-1">
        {diasDelMes.map((dia, idx) => {
          if (dia === null) {
            return <div key={`empty-${idx}`} />;
          }

          const mesStr = String(mesVista.mes + 1).padStart(2, "0");
          const diaStr = String(dia).padStart(2, "0");
          const fechaStr = `${mesVista.año}-${mesStr}-${diaStr}`;

          const esHoy = fechaStr === hoy.toISOString().split("T")[0];
          const estaSeleccionada = fechaStr === fechaSeleccionada;
          const sePuede = esFechaValida(dia);

          return (
            <button
              key={dia}
              type="button"
              disabled={!sePuede}
              onClick={() => seleccionarFecha(dia)}
              className={`
                aspect-square rounded-xl text-sm font-bold transition-all
                ${
                  !sePuede
                    ? "text-gray-300 cursor-not-allowed opacity-50"
                    : "hover:bg-pink-100 active:scale-95"
                }
                ${esHoy && !estaSeleccionada ? "ring-2 ring-pink-300" : ""}
                ${
                  estaSeleccionada
                    ? "bg-gradient-to-br from-pink-500 to-fuchsia-600 text-white shadow-lg shadow-pink-500/30"
                    : "text-gray-700 bg-white"
                }
              `}
            >
              {dia}
            </button>
          );
        })}
      </div>

      <p className="mt-3 text-xs text-center text-gray-500">
        Solo se muestran los días con horarios disponibles
      </p>
    </div>
  );
}
</file>

<file path="lib/admin/tema.ts">
import { useModoOscuro } from "@/hooks/useModoOscuro";

export type Tema = {
  oscuro: boolean;
  listo: boolean;
  alternar: () => void;
  bg: string;
  tarjeta: string;
  borde: string;
  texto: string;
  texto2: string;
  suave: string;
  divisor: string;
  filaHover: string;
  input: string;
  btnPrimario: string;
  btnNeutro: string;
  badge: (activo: boolean) => string;
};

export function useTema(): Tema {
  const { modoOscuro, setModoOscuro, listo } = useModoOscuro();
  const o = modoOscuro;

  return {
    oscuro: o,
    listo,
    alternar: () => setModoOscuro(!o),
    bg: o ? "bg-gray-900" : "bg-gray-50",
    tarjeta: o
      ? "bg-gray-800 shadow-sm shadow-black/20"
      : "bg-white shadow-sm shadow-gray-200/50",
    borde: o ? "border-gray-700" : "border-gray-200",
    texto: o ? "text-gray-100" : "text-gray-900",
    texto2: o ? "text-gray-400" : "text-gray-500",
    suave: o ? "bg-gray-800/50" : "bg-gray-50",
    divisor: o ? "divide-gray-700" : "divide-gray-100",
    filaHover: o ? "hover:bg-gray-800/50" : "hover:bg-gray-50/80",
    input: o
      ? "!bg-gray-800 !border-gray-600 !text-gray-100 placeholder:!text-gray-400 rounded-lg focus:ring-2 focus:ring-pink-500/20 focus:border-pink-500"
      : "!bg-white !border-gray-200 !text-gray-900 placeholder:!text-gray-400 rounded-lg focus:ring-2 focus:ring-pink-500/20 focus:border-pink-500",
    btnPrimario:
      "h-10 px-4 bg-gradient-to-r from-pink-500 to-fuchsia-600 text-white font-medium rounded-lg shadow-sm shadow-pink-500/20 hover:brightness-110 active:scale-[0.98] transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed",
    btnNeutro: o
      ? "h-10 px-4 bg-gray-700 text-gray-200 hover:bg-gray-600 rounded-lg transition-all duration-200 active:scale-[0.98]"
      : "h-10 px-4 bg-gray-100 text-gray-700 hover:bg-gray-200 rounded-lg transition-all duration-200 active:scale-[0.98]",
    badge: (activo: boolean) =>
      activo
        ? "bg-emerald-500/10 text-emerald-600 ring-1 ring-emerald-500/20 rounded-full px-2.5 py-0.5 text-xs font-medium"
        : o
          ? "bg-gray-700/50 text-gray-300 ring-1 ring-gray-600/50 rounded-full px-2.5 py-0.5 text-xs font-medium"
          : "bg-gray-100 text-gray-600 ring-1 ring-gray-200 rounded-full px-2.5 py-0.5 text-xs font-medium",
  };
}

export const ADMIN_CSS = `
.adm-scroll::-webkit-scrollbar{width:6px;height:6px}
.adm-scroll::-webkit-scrollbar-track{background:transparent}
.adm-scroll::-webkit-scrollbar-thumb{background:#ec4899;border-radius:99px}
.adm-scroll::-webkit-scrollbar-thumb:hover{background:#be185d}
.adm-scroll{scrollbar-width:thin;scrollbar-color:#ec4899 transparent}
@keyframes admIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
@keyframes admToast{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:none}}
@keyframes admSheet{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}
.adm-in{animation:admIn .3s ease-out both}
.adm-toast{animation:admToast .25s ease-out both}
.adm-sheet{animation:admSheet .3s cubic-bezier(.2,.8,.2,1) both}
@media (prefers-reduced-motion:reduce){.adm-in,.adm-toast,.adm-sheet{animation:none}}
`;
